{
  "name": "lionscope-workspace",
  "version": "0.1.1",
  "private": true,
  "description": "Lionscope — lightweight Android profiler with a web dashboard",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risyadul/Lionscope.git"
  },
  "homepage": "https://github.com/risyadul/Lionscope",
  "type": "module",
  "workspaces": [
    "protocol",
    "server",
    "dashboard",
    "cli"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lionscope": "npm run build -w @lionscope/dashboard && npm run start -w @lionscope/server",
    "dev": "concurrently -k -n server,dashboard -c blue,magenta \"npm run dev -w @lionscope/server\" \"npm run dev -w @lionscope/dashboard\"",
    "build": "npm run build -w @lionscope/dashboard",
    "build:cli": "npm run build -w lionscope",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
