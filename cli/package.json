{
  "name": "lionscope",
  "version": "0.5.1",
  "description": "Lightweight Android profiler and Layout Inspector in your browser, with MCP tools for AI agents: CPU, memory, frames, stalls, layouts and logcat over adb",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/risyadul/Lionscope.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/risyadul/Lionscope#readme",
  "bugs": {
    "url": "https://github.com/risyadul/Lionscope/issues"
  },
  "keywords": [
    "android",
    "profiler",
    "adb",
    "performance",
    "fps",
    "jank",
    "frame-metrics",
    "cpu",
    "memory",
    "logcat",
    "dashboard",
    "layout-inspector",
    "ui-inspector",
    "view-hierarchy",
    "emulator",
    "uiautomator",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude-code",
    "cursor"
  ],
  "type": "module",
  "bin": {
    "lionscope": "dist/lionscope.mjs"
  },
  "files": [
    "dist",
    "dashboard",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @lionscope/dashboard && tsx scripts/build.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
