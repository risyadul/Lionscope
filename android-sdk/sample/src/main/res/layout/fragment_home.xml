<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately heavy (nested cards through <include>), so the Layouts tab has something to show. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="@string/home_body"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <Button
            android:id="@+id/toggle_alias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toggle_alias" />

        <Button
            android:id="@+id/block_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/block_main" />

        <Button
            android:id="@+id/read_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_file" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_dashboard"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <include layout="@layout/view_dashboard_card" />

        <include layout="@layout/view_dashboard_card" />

        <include layout="@layout/view_dashboard_card" />

        <include layout="@layout/view_dashboard_card" />

        <include layout="@layout/view_dashboard_card" />

        <include layout="@layout/view_dashboard_card" />
    </LinearLayout>
</ScrollView>
