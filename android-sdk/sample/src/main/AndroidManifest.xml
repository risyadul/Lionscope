<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The network demo talks to sample-api.mjs on the laptop (10.0.2.2 from an emulator). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SampleApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LionscopeSample"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ComposeShopActivity"
            android:exported="true"
            android:theme="@style/Theme.LionscopeSample.Compose" />
        <activity
            android:name=".NetworkActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
